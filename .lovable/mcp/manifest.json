            },
            "status": {
              "default": "agendado",
              "type": "string"
            },
            "modality": {
              "description": "Presencial ou Online.",
              "type": "string"
            },
            "consultation_value": {
              "type": "number",
              "minimum": 0
            },
            "clinic_percentage": {
              "description": "Comissão da clínica (padrão 25).",
