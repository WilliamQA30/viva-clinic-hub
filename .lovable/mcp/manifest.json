    "tools": [
      {
        "name": "list_patients",
        "title": "Listar pacientes",
        "description": "Lista pacientes da clínica com filtros opcionais por nome/CPF/telefone, status de CRM e situação ativa.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Busca por nome, CPF ou telefone.",
              "type": "string"
            },
            "crm_status": {
              "description": "Filtra pelo status de CRM (ex.: em_acompanhamento, perdido).",
              "type": "string"
            },
            "is_active": {
              "description": "Filtra pacientes ativos ou inativos.",
              "type": "boolean"
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_patient",
        "title": "Detalhes do paciente",
        "description": "Retorna o cadastro completo de um paciente e suas consultas mais recentes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "patient_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID do paciente."
            },
            "appointments_limit": {
              "default": 20,
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "patient_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_patient",
        "title": "Cadastrar paciente",
        "description": "Cria um novo paciente. Para menores de 18 anos, informe também os dados do responsável.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2
            },
            "cpf": {
              "type": "string",
              "minLength": 1
            },
            "phone": {
              "type": "string",
              "minLength": 8,
              "description": "Telefone com DDD; use + para números internacionais."
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "birth_date": {
              "description": "Formato AAAA-MM-DD.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "address": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "referral_source": {
              "type": "string"
            },
            "guardian_name": {
              "type": "string"
            },
            "guardian_cpf": {
              "type": "string"
            },
            "guardian_phone": {
              "type": "string"
            },
            "guardian_relationship": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "cpf",
            "phone"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_patient",
        "title": "Atualizar paciente",
