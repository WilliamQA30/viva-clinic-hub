              "minimum": 0,
              "maximum": 100
            },
            "is_package": {
              "type": "boolean"
            },
            "package_session_number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "package_total_sessions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "notes": {
              "type": "string"
