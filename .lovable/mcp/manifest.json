            },
            "name": {
              "type": "string",
              "minLength": 2
            },
            "phone": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "address": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "is_active": {
              "type": "boolean"
            },
            "crm_status": {
              "type": "string"
            },
            "crm_status_locked": {
              "type": "boolean"
            },
            "crm_notes": {
              "type": "string"
            },
            "crm_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "inactivation_reason": {
              "type": "string"
            }
          },
          "required": [
            "patient_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_appointments",
